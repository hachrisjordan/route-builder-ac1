                  }
                }));
              }
            }}
              size="small"
            style={{ width: '110px' }}
            />
          </div>
        <div style={{ display: 'flex', justifyContent: 'flex-end' }}>
          <Button 
            size="small" 
            onClick={() => setGroupFilters(prev => ({
              ...prev,
              [filterId]: {
                ...prev[filterId],
                pointsFilter: null
              }
            }))}
            style={{ marginRight: '8px' }}
          >
            Reset
          </Button>
          <Button 
            type="primary" 
            size="small"
            onClick={() => {}}
          >
            Apply
          </Button>
        </div>
      </div>
    );
  };

  // Render points dropdown for segment-based filters
  const renderSegmentPointsDropdown = (filterId) => {
    const [minPoints, maxPoints] = pointsRange;
