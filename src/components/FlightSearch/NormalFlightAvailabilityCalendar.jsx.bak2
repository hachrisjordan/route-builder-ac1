          />
        </div>
        <div style={{ 
          maxHeight: '400px', 
          overflowY: 'auto',
          padding: '8px 0'
        }}>
          {filteredDates.map(dateString => (
            <div 
              key={dateString} 
              style={{ 
                padding: '4px 12px',
                cursor: 'pointer',
                '&:hover': {
                  backgroundColor: '#f5f5f5'
                }
              }}
            >
              <Checkbox
                checked={dateFilter.includes(dateString)}
                onChange={(e) => {
                  const isChecked = e.target.checked;
                  setSegmentFilters(prev => ({
                    ...prev,
                    [filterId]: {
                      ...prev[filterId],
                      dateFilter: isChecked 
                        ? [...(prev[filterId]?.dateFilter || []), dateString]
                        : (prev[filterId]?.dateFilter || []).filter(d => d !== dateString)
                    }
                  }));
                }}
              >
                {formatDateForDisplay(dateString)}
              </Checkbox>
            </div>
          ))}
          {filteredDates.length === 0 && (
            <div style={{ padding: '8px 12px', color: '#999', textAlign: 'center' }}>
              No dates found
            </div>
          )}
        </div>
        {dateFilter.length > 0 && (
          <div style={{ padding: '8px 12px', borderTop: '1px solid #f0f0f0' }}>
            <Button 
              size="small"
              type="primary"
              onClick={() => setSegmentFilters(prev => ({
                ...prev,
                [filterId]: {
                  ...prev[filterId],
                  dateFilter: []
                }
              }))}
              block
            >
              Clear Selections ({dateFilter.length})
            </Button>
          </div>
        )}
      </div>
    );
  };

  // Render additional filter line content
  const renderAdditionalFilter = () => {
    if (additionalFilters.length === 0) return null;
    
    return additionalFilters.map(filter => {
      if (filter.type === 'group') {
        const currentFilter = groupFilters[filter.id] || {};
        return (
          <div key={filter.id} style={{ 
            display: 'flex', 
            flexDirection: 'column',
            gap: '8px', 
            marginBottom: '8px',
            width: '100%'
          }}>
            <div style={{ 
              display: 'flex',
              gap: '8px', 
              alignItems: 'center',
            }}>
              <span style={{ 
                fontWeight: 600, 
                marginRight: '4px',
                fontSize: '14px'
              }}>
                Group-based Filter
              </span>
              <span style={{ whiteSpace: 'nowrap' }}>for</span>
              <Dropdown 
                overlay={renderOriginDropdown(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={groupFilters[filter.id]?.originFilter?.airports?.length > 0 ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: groupFilters[filter.id]?.originFilter?.airports?.length > 0 ? 600 : 400
                  }}
                >
                  Origins {groupFilters[filter.id]?.originFilter?.airports?.length > 0 && `(${groupFilters[filter.id]?.originFilter?.airports?.length})`}
                </Button>
              </Dropdown>
              
              <span style={{ whiteSpace: 'nowrap' }}>to</span>
              <Dropdown 
                overlay={renderDestDropdown(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={groupFilters[filter.id]?.destFilter?.airports?.length > 0 ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: groupFilters[filter.id]?.destFilter?.airports?.length > 0 ? 600 : 400
                  }}
                >
                  Destinations {groupFilters[filter.id]?.destFilter?.airports?.length > 0 && `(${groupFilters[filter.id]?.destFilter?.airports?.length})`}
                </Button>
              </Dropdown>
              <span style={{ whiteSpace: 'nowrap' }}>:</span>
              
              <Button 
                type="text" 
                icon={<DeleteOutlined />} 
                size="small"
                style={{ marginLeft: 'auto', color: '#ff4d4f' }}
                onClick={() => deleteFilter(filter.id, 'group')}
              />
            </div>

            {/* Add filter controls UI for group filters */}
            <div style={{ 
              display: 'flex', 
              flexWrap: 'wrap',
              gap: '8px', 
              alignItems: 'center',
              marginLeft: '16px',
              paddingTop: '4px'
            }}>
              <Dropdown 
                dropdownRender={() => renderGroupClassDropdown(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={currentFilter.classFilter?.length > 0 ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: currentFilter.classFilter?.length > 0 ? 600 : 400
                  }}
                >
                  Class {currentFilter.classFilter?.length > 0 && `(${currentFilter.classFilter.length})`}
                </Button>
              </Dropdown>
              
              <Dropdown 
                dropdownRender={() => renderGroupSourcesDropdown(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={currentFilter.sourceFilter?.sources?.length > 0 ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: currentFilter.sourceFilter?.sources?.length > 0 ? 600 : 400
                  }}
                >
                  Sources {currentFilter.sourceFilter?.sources?.length > 0 && `(${currentFilter.sourceFilter.sources.length})`}
                </Button>
              </Dropdown>
              
              <Dropdown 
                dropdownRender={() => renderGroupAirlinesDropdown(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={currentFilter.airlinesFilter?.airlines?.length > 0 ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: currentFilter.airlinesFilter?.airlines?.length > 0 ? 600 : 400
                  }}
                >
                  Airlines {currentFilter.airlinesFilter?.airlines?.length > 0 && `(${currentFilter.airlinesFilter.airlines.length})`}
                </Button>
              </Dropdown>
              
              <Dropdown 
                dropdownRender={() => renderGroupPointsDropdown(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={currentFilter.pointsFilter ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: currentFilter.pointsFilter ? 600 : 400
                  }}
                >
                  Points {currentFilter.pointsFilter && `(${currentFilter.pointsFilter[0].toLocaleString()}-${currentFilter.pointsFilter[1].toLocaleString()})`}
                </Button>
              </Dropdown>
              
              <Dropdown 
                dropdownRender={() => renderGroupDatesDropdown(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={currentFilter.dateFilter?.length > 0 ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: currentFilter.dateFilter?.length > 0 ? 600 : 400
                  }}
                >
                  Dates {currentFilter.dateFilter?.length > 0 && `(${currentFilter.dateFilter.length})`}
                </Button>
              </Dropdown>
              
              <Checkbox 
                checked={currentFilter.directOnly || false}
                onChange={e => setGroupFilters(prev => ({
                  ...prev,
                  [filter.id]: {
                    ...prev[filter.id],
                    directOnly: e.target.checked
                  }
                }))}
                style={{ marginLeft: '8px' }}
              >
                <span style={{ fontWeight: currentFilter.directOnly ? 600 : 400 }}>Direct Only</span>
              </Checkbox>
            </div>
          </div>
        );
      } else if (filter.type === 'segment') {
        const currentFilter = segmentFilters[filter.id] || {};
        return (
          <div key={filter.id} style={{ 
            display: 'flex', 
            flexDirection: 'column',
            gap: '8px', 
            marginBottom: '8px',
            width: '100%'
          }}>
            <div style={{ 
              display: 'flex',
              gap: '8px', 
              alignItems: 'center',
            }}>
              <span style={{ 
                fontWeight: 600, 
                marginRight: '4px',
                fontSize: '14px'
              }}>
                Segment-based Filter
              </span>
              <span style={{ whiteSpace: 'nowrap' }}>for</span>
              <Dropdown 
                overlay={renderSegmentsDropdownSimple(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={segmentFilters[filter.id]?.segments?.length > 0 ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: segmentFilters[filter.id]?.segments?.length > 0 ? 600 : 400
                  }}
                >
                  Segments {segmentFilters[filter.id]?.segments?.length > 0 && `(${segmentFilters[filter.id]?.segments?.length})`}
                </Button>
              </Dropdown>
              <span style={{ whiteSpace: 'nowrap' }}>:</span>
              
              <Button 
                type="text" 
                icon={<DeleteOutlined />} 
                size="small"
                style={{ marginLeft: 'auto', color: '#ff4d4f' }}
                onClick={() => deleteFilter(filter.id, 'segment')}
              />
            </div>

            {/* Add filter controls UI for segment filters */}
            <div style={{ 
              display: 'flex', 
              flexWrap: 'wrap',
              gap: '8px', 
              alignItems: 'center',
              marginLeft: '16px',
              paddingTop: '4px'
            }}>
              <Dropdown 
                dropdownRender={() => renderSegmentClassDropdown(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={currentFilter.classFilter?.length > 0 ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: currentFilter.classFilter?.length > 0 ? 600 : 400
                  }}
                >
                  Class {currentFilter.classFilter?.length > 0 && `(${currentFilter.classFilter.length})`}
                </Button>
              </Dropdown>
              
              <Dropdown 
                dropdownRender={() => renderSegmentSourcesDropdown(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={currentFilter.sourceFilter?.sources?.length > 0 ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: currentFilter.sourceFilter?.sources?.length > 0 ? 600 : 400
                  }}
                >
                  Sources {currentFilter.sourceFilter?.sources?.length > 0 && `(${currentFilter.sourceFilter.sources.length})`}
                </Button>
              </Dropdown>
              
              <Dropdown 
                dropdownRender={() => renderSegmentAirlinesDropdown(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={currentFilter.airlinesFilter?.airlines?.length > 0 ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: currentFilter.airlinesFilter?.airlines?.length > 0 ? 600 : 400
                  }}
                >
                  Airlines {currentFilter.airlinesFilter?.airlines?.length > 0 && `(${currentFilter.airlinesFilter.airlines.length})`}
                </Button>
              </Dropdown>
              
              <Dropdown 
                dropdownRender={() => renderSegmentPointsDropdown(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={currentFilter.pointsFilter ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: currentFilter.pointsFilter ? 600 : 400
                  }}
                >
                  Points {currentFilter.pointsFilter && `(${currentFilter.pointsFilter[0].toLocaleString()}-${currentFilter.pointsFilter[1].toLocaleString()})`}
                </Button>
              </Dropdown>
              
              <Dropdown 
                dropdownRender={() => renderSegmentDatesDropdown(filter.id)}
                trigger={['click']}
              >
                <Button 
                  type={currentFilter.dateFilter?.length > 0 ? "primary" : "default"}
                  size="small"
                  icon={<DownOutlined />}
                  style={{ 
                    fontWeight: currentFilter.dateFilter?.length > 0 ? 600 : 400
                  }}
                >
                  Dates {currentFilter.dateFilter?.length > 0 && `(${currentFilter.dateFilter.length})`}
                </Button>
              </Dropdown>
              
              <Checkbox 
                checked={currentFilter.directOnly || false}
                onChange={e => setSegmentFilters(prev => ({
                  ...prev,
                  [filter.id]: {
                    ...prev[filter.id],
                    directOnly: e.target.checked
                  }
                }))}
                style={{ marginLeft: '8px' }}
              >
                <span style={{ fontWeight: currentFilter.directOnly ? 600 : 400 }}>Direct Only</span>
              </Checkbox>
            </div>
          </div>
        );
      }
      return null;
    });
  };

  // Filter flights based on selected segments, classes, direct filter, and sources
  const filterFlights = (flights) => {
    // Check if there are any active filters
    const hasGlobalFilters = 
      segmentFilter.segments.length > 0 || 
      classFilter.length > 0 || 
      directFilter ||
      sourceFilter.sources.length > 0 ||
      airlinesFilter.airlines.length > 0 ||
      pointsFilter ||
      dateFilter.length > 0;
    
    const hasGroupFilters = Object.keys(groupFilters).length > 0;
    const hasSegmentFilters = Object.keys(segmentFilters).length > 0;
    
    // If no filters at all, just return valid segments
    if (!hasGlobalFilters && !hasGroupFilters && !hasSegmentFilters) {
      return Object.entries(flights).reduce((filtered, [route, data]) => {
        // Only include segments that follow the route sequence
        if (isValidSegmentForRoute(route)) {
          filtered[route] = data;
        }
        return filtered;
      }, {});
    }
    
    return Object.entries(flights).reduce((filtered, [route, data]) => {
      // First check if this is a valid segment for the route
      if (!isValidSegmentForRoute(route)) {
        return filtered;
      }

      // Extract origin and destination from route
      const [origin, destination] = route.split('-');
      
      // 1. Apply Global Filters first (highest priority) - these apply to ALL routes
      let passesGlobalFilters = true;
      
      if (hasGlobalFilters) {
      // Check segment filter
        let passesGlobalSegmentFilter = true;
        if (segmentFilter.segments.length > 0) {
      const isInSegmentFilter = segmentFilter.segments.includes(route);
          passesGlobalSegmentFilter = 
        (segmentFilter.mode === 'include' && isInSegmentFilter) || 
        (segmentFilter.mode === 'exclude' && !isInSegmentFilter);
        }
        
        // Check class filter
        let passesGlobalClassFilter = true;
        if (classFilter.length > 0) {
          passesGlobalClassFilter = classFilter.some(cls => {
            switch(cls) {
              case 'Economy': return data.classes.Y.available;
              case 'Premium Economy': return data.classes.W.available;
              case 'Business': return data.classes.J.available;
              case 'First': return data.classes.F.available;
              default: return false;
            }
          });
        }
        
        // Check direct filter
        let passesGlobalDirectFilter = true;
      if (directFilter) {
        if (classFilter.length === 0) {
          // If Direct filter is ON but no Class filter is selected
          // Show routes with ANY direct cabin class
            passesGlobalDirectFilter = 
            data.classes.Y.direct || 
            data.classes.W.direct || 
            data.classes.J.direct || 
            data.classes.F.direct;
        } else {
          // If Direct filter is ON and specific Class filters are selected
          // Show routes with direct flights in ANY of the selected cabin classes
            passesGlobalDirectFilter = classFilter.some(cls => {
            switch(cls) {
              case 'Economy': return data.classes.Y.direct;
              case 'Premium Economy': return data.classes.W.direct;
              case 'Business': return data.classes.J.direct;
              case 'First': return data.classes.F.direct;
              default: return false;
            }
          });
        }
        }
        
        // Check date filter
        let passesGlobalDateFilter = true;
        if (dateFilter.length > 0) {
          // If date filter is applied, this will be checked later in the calendar rendering
          // since dateString is a property of the calendar cell, not the route
          // For now, we assume it passes
        }
        
        // Combine all global filters
        passesGlobalFilters = 
          passesGlobalSegmentFilter && 
          passesGlobalClassFilter && 
          passesGlobalDirectFilter &&
          passesGlobalDateFilter;
      }
      
      // If it fails global filters, no need to check other filters (global has highest priority)
      if (hasGlobalFilters && !passesGlobalFilters) {
        return filtered;
      }
      
      // 2. Apply Group Filters (second priority) - only apply to routes in scope
      let passesGroupFilters = true;
      let isInAnyGroupFilterScope = false;
      
      if (hasGroupFilters) {
        // Process group filters in order they were added
        for (const filterId of Object.keys(groupFilters)) {
          const filter = groupFilters[filterId];
          
          // Check if this group filter applies to this route
          const originFilter = filter.originFilter || { mode: 'include', airports: [] };
          const destFilter = filter.destFilter || { mode: 'include', airports: [] };
          
          // Skip if no origins or destinations selected
          if (originFilter.airports.length === 0 || destFilter.airports.length === 0) {
            continue;
          }
          
          // Check if origin and destination match the group filter's scope
          const matchesOrigin = originFilter.airports.includes(origin);
          const matchesDest = destFilter.airports.includes(destination);
          
          // Check if route is in scope for this group filter
          const originInScope = 
            (originFilter.mode === 'include' && matchesOrigin) || 
            (originFilter.mode === 'exclude' && !matchesOrigin);
          
          const destInScope = 
            (destFilter.mode === 'include' && matchesDest) || 
            (destFilter.mode === 'exclude' && !matchesDest);
          
          const inScope = originInScope && destInScope;
          
          // If not in scope, skip to next group filter
          if (!inScope) {
            continue;
          }
          
          // This route is in scope for at least one group filter
          isInAnyGroupFilterScope = true;
          
          // Now check filters within this group
          // Check class filter
          let passesGroupClassFilter = true;
          if (filter.classFilter && filter.classFilter.length > 0) {
            passesGroupClassFilter = filter.classFilter.some(cls => {
          switch(cls) {
            case 'Economy': return data.classes.Y.available;
            case 'Premium Economy': return data.classes.W.available;
            case 'Business': return data.classes.J.available;
            case 'First': return data.classes.F.available;
            default: return false;
          }
        });
      }
      
          // Check direct filter
          let passesGroupDirectFilter = true;
          if (filter.directFilter) {
            if (!filter.classFilter || filter.classFilter.length === 0) {
              // If Direct filter is ON but no Class filter is selected
              passesGroupDirectFilter = 
                data.classes.Y.direct || 
                data.classes.W.direct || 
                data.classes.J.direct || 
                data.classes.F.direct;
            } else {
              // If Direct filter is ON and specific Class filters are selected
              passesGroupDirectFilter = filter.classFilter.some(cls => {
                switch(cls) {
                  case 'Economy': return data.classes.Y.direct;
                  case 'Premium Economy': return data.classes.W.direct;
                  case 'Business': return data.classes.J.direct;
                  case 'First': return data.classes.F.direct;
                  default: return false;
                }
              });
            }
          }
          
          // Check date filter
          let passesGroupDateFilter = true;
          if (filter.dateFilter && filter.dateFilter.length > 0) {
            // This will be checked in the calendar rendering
          }
          
          // Combine all group filters for this specific group
          const passesThisGroupFilter = 
            passesGroupClassFilter && 
            passesGroupDirectFilter && 
            passesGroupDateFilter;
          
          // If this route doesn't pass the filter for this group, but is in scope
          // Mark it as not passing group filters
          if (!passesThisGroupFilter) {
            passesGroupFilters = false;
            break;
          }
        }
      }
      
      // If the route is in scope for group filters but doesn't pass them, filter it out
      // If it's not in scope for any group filter, keep it (don't apply group filters)
      if (isInAnyGroupFilterScope && !passesGroupFilters) {
      return filtered;
      }
      
      // 3. Apply Segment Filters (lowest priority) - only apply to routes in scope
      let passesSegmentFilters = true;
      let isInAnySegmentFilterScope = false;
      
      if (hasSegmentFilters) {
        // Process segment filters in order they were added
        for (const filterId of Object.keys(segmentFilters)) {
          const filter = segmentFilters[filterId];
          
          // Check if this segment filter applies to this route
          const appliesTo = filter.segments || [];
          
          // Skip if no segments selected
          if (appliesTo.length === 0) {
            continue;
          }
          
          // Check if route is in the segment filter's scope
          const inScope = appliesTo.includes(route);
          
          // If not in scope, skip to next segment filter
          if (!inScope) {
            continue;
          }
          
          // This route is in scope for at least one segment filter
          isInAnySegmentFilterScope = true;
          
          // Now check filters within this segment
          // Check class filter
          let passesSegmentClassFilter = true;
          if (filter.classFilter && filter.classFilter.length > 0) {
            passesSegmentClassFilter = filter.classFilter.some(cls => {
              switch(cls) {
                case 'Economy': return data.classes.Y.available;
                case 'Premium Economy': return data.classes.W.available;
                case 'Business': return data.classes.J.available;
                case 'First': return data.classes.F.available;
                default: return false;
              }
            });
          }
          
          // Check direct filter
          let passesSegmentDirectFilter = true;
          if (filter.directFilter) {
            if (!filter.classFilter || filter.classFilter.length === 0) {
              // If Direct filter is ON but no Class filter is selected
              passesSegmentDirectFilter = 
                data.classes.Y.direct || 
                data.classes.W.direct || 
                data.classes.J.direct || 
                data.classes.F.direct;
            } else {
              // If Direct filter is ON and specific Class filters are selected
              passesSegmentDirectFilter = filter.classFilter.some(cls => {
                switch(cls) {
                  case 'Economy': return data.classes.Y.direct;
                  case 'Premium Economy': return data.classes.W.direct;
                  case 'Business': return data.classes.J.direct;
                  case 'First': return data.classes.F.direct;
                  default: return false;
                }
              });
            }
          }
          
          // Check date filter
          let passesSegmentDateFilter = true;
          if (filter.dateFilter && filter.dateFilter.length > 0) {
            // This will be checked in the calendar rendering
          }
          
          // Combine all segment filters for this specific segment
          const passesThisSegmentFilter = 
            passesSegmentClassFilter && 
            passesSegmentDirectFilter && 
            passesSegmentDateFilter;
          
          // If this route doesn't pass the filter for this segment, but is in scope
          // Mark it as not passing segment filters
          if (!passesThisSegmentFilter) {
            passesSegmentFilters = false;
            break;
          }
        }
      }
      
      // If the route is in scope for segment filters but doesn't pass them, filter it out
      // If it's not in scope for any segment filter, keep it (don't apply segment filters)
      if (isInAnySegmentFilterScope && !passesSegmentFilters) {
        return filtered;
      }
      
      // If the route passes all applicable filters, or is not in scope for any specific filter, keep it
      filtered[route] = data;
      return filtered;
    }, {});
  };

  // Helper function to properly normalize boolean values that might be stored as strings
  const normalizeBoolean = (value) => {
    if (typeof value === 'boolean') return value;
    if (typeof value === 'string') {
      return value.toLowerCase() === 'true';
    }
    return Boolean(value);
  };

  // Get flights for class with specific filters applied (global, group, and segment)
  const getFlightsForClassWithFilters = (route, classCode, date, classData) => {
    // Safety check for inputs
    if (!route || !classCode || !date || !classData) {
      return [];
    }

    // Get flights for this class with raw data
    const flights = getEnrichedFlightData(route, classCode, date, classData);
    
    // If no flights, return empty array
    if (!flights || flights.length === 0) return [];
    
    // Start with all flights
    let filteredFlights = [...flights];
    
    // Parse route to get origin and destination
    const [origin, destination] = route.split('-');
    
    // Check if there are any active segment filters for this specific route
    const activeSegmentFilters = Object.values(segmentFilters).filter(
      filter => filter.segments?.length > 0 && filter.segments.includes(route)
    );
    
    // Check if there are any active group filters that match this route
    const activeGroupFilters = Object.values(groupFilters).filter(filter => {
      const originFilter = filter.originFilter || { mode: 'include', airports: [] };
      const destFilter = filter.destFilter || { mode: 'include', airports: [] };
      
      // Check if origin matches
      const originMatch = originFilter.airports.length === 0 || 
        (originFilter.mode === 'include' ? 
          originFilter.airports.includes(origin) : 
          !originFilter.airports.includes(origin));
          
      // Check if destination matches
      const destMatch = destFilter.airports.length === 0 || 
        (destFilter.mode === 'include' ? 
          destFilter.airports.includes(destination) : 
          !destFilter.airports.includes(destination));
          
      const matches = originMatch && destMatch;
      return matches;
    });
    
    // Priority: Segment > Group > Global
    // If we have segment filters that apply to this route, use them
    if (activeSegmentFilters.length > 0) {
      let passesAnySegmentFilter = false;
      
      for (const segmentFilter of activeSegmentFilters) {
        let currentFilteredFlights = [...filteredFlights];
        
        // Apply direct only filter for segment first as it's most restrictive
        if (segmentFilter.directOnly) {
          currentFilteredFlights = currentFilteredFlights.filter(flight => {
            // Check the ${classCode}Direct property, normalizing boolean values
            const directValue = flight.rawData?.[`${classCode}Direct`];
            const isDirect = normalizeBoolean(directValue);
            return isDirect;
          });
          if (currentFilteredFlights.length === 0) {
            continue; // Skip to next filter if no flights pass
          }
        }
        
        // Apply segment source filter
        if (segmentFilter.sourceFilter?.sources?.length > 0) {
          currentFilteredFlights = currentFilteredFlights.filter(flight => {
            const flightSource = flight.rawData?.source || '';
            const isIncluded = segmentFilter.sourceFilter.sources.includes(flightSource);
            return segmentFilter.sourceFilter.mode === 'include' ? isIncluded : !isIncluded;
          });
          
          if (currentFilteredFlights.length === 0) {
            continue; // Skip to next filter if no flights pass
          }
        }
        
        // Apply segment airline filter
        if (segmentFilter.airlinesFilter?.airlines?.length > 0) {
          currentFilteredFlights = currentFilteredFlights.filter(flight => {
            const flightAirlines = flight.rawData?.[`${classCode}Airlines`]?.split(', ') || [];
            const hasMatchingAirline = flightAirlines.some(airline => 
              segmentFilter.airlinesFilter.airlines.includes(airline)
            );
            return segmentFilter.airlinesFilter.mode === 'include' ? hasMatchingAirline : !hasMatchingAirline;
          });
          
          if (currentFilteredFlights.length === 0) {
            continue; // Skip to next filter if no flights pass
          }
        }
        
        // Apply segment points filter
        if (segmentFilter.pointsFilter) {
          currentFilteredFlights = currentFilteredFlights.filter(flight => {
            const points = parseInt(flight.rawData?.[`${classCode}MileageCost`] || '0', 10);
            return points >= segmentFilter.pointsFilter[0] && points <= segmentFilter.pointsFilter[1];
          });
          
          if (currentFilteredFlights.length === 0) {
            continue; // Skip to next filter if no flights pass
          }
        }
        
        // Apply segment date filter
        if (segmentFilter.dateFilter?.length > 0) {
          if (!segmentFilter.dateFilter.includes(date)) {
            continue; // Skip to next filter if date doesn't match
          }
        }
        
        // If we get here, this filter has passed flights
        if (currentFilteredFlights.length > 0) {
          passesAnySegmentFilter = true;
          filteredFlights = currentFilteredFlights; // Update filtered flights with segment filter results
          break;
        }
      }
      
      if (!passesAnySegmentFilter) {
        return []; // No segment filters passed, return empty array
      }
    }
    // If we have group filters that apply to this route, use them
    else if (activeGroupFilters.length > 0) {
      let passesAnyGroupFilter = false;
      
      for (const groupFilter of activeGroupFilters) {
        let currentFilteredFlights = [...filteredFlights];
        
        // Apply direct only filter for group first as it's most restrictive
        if (groupFilter.directOnly) {
          currentFilteredFlights = currentFilteredFlights.filter(flight => {
            // Check the ${classCode}Direct property, normalizing boolean values
            const directValue = flight.rawData?.[`${classCode}Direct`];
            const isDirect = normalizeBoolean(directValue);
            return isDirect;
          });
          
          if (currentFilteredFlights.length === 0) {
            continue; // Skip to next filter if no flights pass
          }
        }
        
        // Apply group source filter
        if (groupFilter.sourceFilter?.sources?.length > 0) {
          currentFilteredFlights = currentFilteredFlights.filter(flight => {
            const flightSource = flight.rawData?.source || '';
            const isIncluded = groupFilter.sourceFilter.sources.includes(flightSource);
            return groupFilter.sourceFilter.mode === 'include' ? isIncluded : !isIncluded;
          });
          
          if (currentFilteredFlights.length === 0) {
            continue; // Skip to next filter if no flights pass
          }
        }
        
        // Apply group airline filter
        if (groupFilter.airlinesFilter?.airlines?.length > 0) {
          currentFilteredFlights = currentFilteredFlights.filter(flight => {
            const flightAirlines = flight.rawData?.[`${classCode}Airlines`]?.split(', ') || [];
            const hasMatchingAirline = flightAirlines.some(airline => 
              groupFilter.airlinesFilter.airlines.includes(airline)
            );
            return groupFilter.airlinesFilter.mode === 'include' ? hasMatchingAirline : !hasMatchingAirline;
          });
          
          if (currentFilteredFlights.length === 0) {
            continue; // Skip to next filter if no flights pass
          }
        }
        
        // Apply group points filter
        if (groupFilter.pointsFilter) {
          currentFilteredFlights = currentFilteredFlights.filter(flight => {
            const points = parseInt(flight.rawData?.[`${classCode}MileageCost`] || '0', 10);
            return points >= groupFilter.pointsFilter[0] && points <= groupFilter.pointsFilter[1];
          });
          
          if (currentFilteredFlights.length === 0) {
            continue; // Skip to next filter if no flights pass
          }
        }
        
        // Apply group date filter
        if (groupFilter.dateFilter?.length > 0) {
          if (!groupFilter.dateFilter.includes(date)) {
            continue; // Skip to next filter if date doesn't match
          }
        }
        
        // If we get here, this filter has passed flights
        if (currentFilteredFlights.length > 0) {
          passesAnyGroupFilter = true;
          filteredFlights = currentFilteredFlights; // Update filtered flights with group filter results
          break;
        }
      }
      
      if (!passesAnyGroupFilter) {
        return []; // No group filters passed, return empty array
      }
    }
    // If no specific filters apply to this route, use global filters
    else {
      const hasGlobalFilters = sourceFilter.sources.length > 0 || 
                              airlinesFilter.airlines.length > 0 || 
                              pointsFilter !== null ||
                              dateFilter.length > 0 ||
                              directFilter;
      
      if (hasGlobalFilters) {
        // Apply direct filter first as it's most restrictive
        if (directFilter) {
          filteredFlights = filteredFlights.filter(flight => {
            // Check the ${classCode}Direct property, normalizing boolean values
            const directValue = flight.rawData?.[`${classCode}Direct`];
            const isDirect = normalizeBoolean(directValue);
            return isDirect;
          });
          if (filteredFlights.length === 0) {
            return []; // No flights pass the direct filter
          }
        }
        
        // Apply source filter
        if (sourceFilter.sources.length > 0) {
          filteredFlights = filteredFlights.filter(flight => {
            const flightSource = flight.rawData?.source || '';
            const isIncluded = sourceFilter.sources.includes(flightSource);
            return sourceFilter.mode === 'include' ? isIncluded : !isIncluded;
          });
          
          if (filteredFlights.length === 0) {
            return []; // No flights pass the source filter
          }
        }
        
        // Apply airline filter
        if (airlinesFilter.airlines.length > 0) {
          filteredFlights = filteredFlights.filter(flight => {
            const flightAirlines = flight.rawData?.[`${classCode}Airlines`]?.split(', ') || [];
            const hasMatchingAirline = flightAirlines.some(airline => 
              airlinesFilter.airlines.includes(airline)
            );
            return airlinesFilter.mode === 'include' ? hasMatchingAirline : !hasMatchingAirline;
          });
          
          if (filteredFlights.length === 0) {
            return []; // No flights pass the airline filter
          }
        }
        
        // Apply points filter
        if (pointsFilter !== null) {
          filteredFlights = filteredFlights.filter(flight => {
            const points = parseInt(flight.rawData?.[`${classCode}MileageCost`] || '0', 10);
            return points >= pointsFilter[0] && points <= pointsFilter[1];
          });
          
          if (filteredFlights.length === 0) {
            return []; // No flights pass the points filter
          }
        }
        
        // Apply date filter
        if (dateFilter.length > 0) {
          if (!dateFilter.includes(date)) {
            return []; // Date filtered out at global level
          }
        }
      }
    }
    
    return filteredFlights;
  };

  // Get unique origin airports from flight data
  const getUniqueOriginAirports = () => {
    const airports = new Set();
    
    // Extract from raw data if available
    if (flightData?.rawData && Array.isArray(flightData.rawData)) {
      flightData.rawData.forEach(flight => {
        if (flight.originAirport) {
          airports.add(flight.originAirport);
        }
      });
    }
    
    // Extract from processed data
    if (flightData?.data) {
      Object.keys(flightData.data).forEach(dateString => {
        const dateFlights = flightData.data[dateString];
        
        Object.keys(dateFlights).forEach(route => {
          const [origin] = route.split('-');
          if (origin) {
            airports.add(origin);
          }
        });
      });
    }
    
    // Convert to array of objects with code and name
    return Array.from(airports).map(code => ({
      code,
      name: getAirportName(code) || code
    })).sort((a, b) => a.code.localeCompare(b.code));
  };

  // Get unique destination airports from flight data
  const getUniqueDestinationAirports = () => {
    const airports = new Set();
    
    // Extract from raw data if available
    if (flightData?.rawData && Array.isArray(flightData.rawData)) {
      flightData.rawData.forEach(flight => {
        if (flight.destinationAirport) {
          airports.add(flight.destinationAirport);
        }
      });
    }
    
    // Extract from processed data
    if (flightData?.data) {
      Object.keys(flightData.data).forEach(dateString => {
        const dateFlights = flightData.data[dateString];
        
        Object.keys(dateFlights).forEach(route => {
          const [_, destination] = route.split('-');
          if (destination) {
            airports.add(destination);
          }
        });
      });
    }
    
    // Convert to array of objects with code and name
    return Array.from(airports).map(code => ({
      code,
      name: getAirportName(code) || code
    })).sort((a, b) => a.code.localeCompare(b.code));
  };

  // Helper function to get airport name from code (now using dynamic data from airports.js)
  const getAirportName = (code) => {
    if (!code) return null;
    
    // Try to find the airport in the imported data
    const airportEntry = airportsData.find(airport => airport.IATA === code);
    
    if (airportEntry) {
      return airportEntry.Name;
    }
    
    // Fallback for common airport groups
    const airportGroupNames = {
      'NYC': 'New York City',
      'LON': 'London',
      'PAR': 'Paris',
      'TYO': 'Tokyo',
      'CHI': 'Chicago',
      'WAS': 'Washington DC',
      'SAS': 'Southeast Asia',
      'CAR': 'Caribbean',
      'EUR': 'Europe',
      'USA': 'United States',
      'CAD': 'Canada',
      'ANZ': 'Australia/New Zealand',
      'ASA': 'Asia',
      'DLL': 'Delta Hub Cities',
      'UAH': 'United Hub Cities'
    };

    return airportGroupNames[code] || code;
  };

  // Render origin dropdown for filters
  const renderOriginDropdown = (filterId) => {
    // Get available airports from the filter
    const currentFilter = groupFilters[filterId] || {};
    const originFilter = currentFilter.originFilter || { mode: 'include', airports: [] };
    
    // Get dynamically generated airport data
    const airports = getUniqueOriginAirports();
    
    // Filter airports based on search text
    const filteredAirports = airports.filter(airport => 
      airport.code.toLowerCase().includes(originSearchText.toLowerCase()) ||
      (airport.name && airport.name.toLowerCase().includes(originSearchText.toLowerCase()))
    );
    
    const handleChange = (newFilter) => {
      setGroupFilters(prev => ({
        ...prev,
        [filterId]: {
          ...prev[filterId],
          originFilter: newFilter
        }
      }));
    };
    
        return (
      <div style={{ 
        backgroundColor: 'white', 
        boxShadow: '0 3px 6px -4px rgba(0,0,0,.12), 0 6px 16px 0 rgba(0,0,0,.08), 0 9px 28px 8px rgba(0,0,0,.05)',
        borderRadius: '8px',
        padding: '8px 0',
        width: '320px'
      }}>
        <div style={{ padding: '4px 12px 8px', borderBottom: '1px solid #f0f0f0' }}>
          <Radio.Group
            value={originFilter.mode}
            onChange={e => handleChange({ mode: e.target.value, airports: originFilter.airports })}
            style={{ display: 'flex', gap: '8px' }}
          >
            <Radio.Button 
              value="include" 
              style={{ flex: 1, textAlign: 'center' }}
            >
              Include
            </Radio.Button>
            <Radio.Button 
              value="exclude" 
              style={{ flex: 1, textAlign: 'center' }}
            >
              Exclude
            </Radio.Button>
          </Radio.Group>
        </div>
        <div style={{ padding: '8px 12px', borderBottom: '1px solid #f0f0f0' }}>
          <Input
            placeholder="Search airports..."
            value={originSearchText}
            onChange={e => setOriginSearchText(e.target.value)}
                size="small"
            allowClear
            onClick={e => e.stopPropagation()}
          />
        </div>
        <div style={{ 
          maxHeight: '400px', 
          overflowY: 'auto',
          padding: '8px 0'
        }}>
          {filteredAirports.length > 0 ? (
            filteredAirports.map(airport => {
              // Find the full airport data if available
              const airportEntry = airportsData.find(a => a.IATA === airport.code);
              
              return (
                <div 
                  key={airport.code} 
                style={{ 
                    padding: '4px 12px',
                    cursor: 'pointer',
                    '&:hover': {
                      backgroundColor: '#f5f5f5'
                    }
                  }}
                >
                  <Checkbox
                    checked={originFilter.airports.includes(airport.code)}
                    onChange={e => {
                      const isChecked = e.target.checked;
                      handleChange({
                        mode: originFilter.mode,
                        airports: isChecked 
                          ? [...originFilter.airports, airport.code]
                          : originFilter.airports.filter(a => a !== airport.code)
                      });
                    }}
                  >
                    <div style={{ display: 'flex', flexDirection: 'column' }}>
                      <span style={{ fontWeight: 500 }}>{airport.code}</span>
                      <span style={{ fontSize: '12px', color: '#666' }}>
                        {airportEntry 
                          ? `${airportEntry.Name} (${airportEntry.Country})` 
                          : (airport.name || '')}
                      </span>
                    </div>
                  </Checkbox>
          </div>
        );
            })
          ) : (
            <div style={{ padding: '8px 12px', color: '#999', textAlign: 'center' }}>
              No airports found
            </div>
          )}
        </div>
        {originFilter.airports.length > 0 && (
          <div style={{ padding: '8px 12px', borderTop: '1px solid #f0f0f0' }}>
              <Button 
                size="small"
              type="primary"
              onClick={() => handleChange({ mode: originFilter.mode, airports: [] })}
              block
            >
              Clear Selections ({originFilter.airports.length})
              </Button>
          </div>
        )}
          </div>
        );
  };

  // Render destination dropdown for filters
  const renderDestDropdown = (filterId) => {
    // Get available airports from the filter
    const currentFilter = groupFilters[filterId] || {};
    const destFilter = currentFilter.destFilter || { mode: 'include', airports: [] };
    
    // Get dynamically generated airport data
    const airports = getUniqueDestinationAirports();
    
    // Filter airports based on search text
    const filteredAirports = airports.filter(airport => 
      airport.code.toLowerCase().includes(destSearchText.toLowerCase()) ||
      (airport.name && airport.name.toLowerCase().includes(destSearchText.toLowerCase()))
    );
    
    const handleChange = (newFilter) => {
      setGroupFilters(prev => ({
        ...prev,
        [filterId]: {
          ...prev[filterId],
          destFilter: newFilter
        }
      }));
    };

    return (
      <div style={{ 
        backgroundColor: 'white', 
        boxShadow: '0 3px 6px -4px rgba(0,0,0,.12), 0 6px 16px 0 rgba(0,0,0,.08), 0 9px 28px 8px rgba(0,0,0,.05)',
        borderRadius: '8px',
        padding: '8px 0',
        width: '320px'
      }}>
        <div style={{ padding: '4px 12px 8px', borderBottom: '1px solid #f0f0f0' }}>
          <Radio.Group
            value={destFilter.mode}
            onChange={e => handleChange({ mode: e.target.value, airports: destFilter.airports })}
            style={{ display: 'flex', gap: '8px' }}
          >
            <Radio.Button 
              value="include" 
              style={{ flex: 1, textAlign: 'center' }}
            >
              Include
            </Radio.Button>
            <Radio.Button 
              value="exclude" 
              style={{ flex: 1, textAlign: 'center' }}
            >
              Exclude
            </Radio.Button>
          </Radio.Group>
        </div>
        <div style={{ padding: '8px 12px', borderBottom: '1px solid #f0f0f0' }}>
          <Input
            placeholder="Search airports..."
            value={destSearchText}
            onChange={e => setDestSearchText(e.target.value)}
            size="small"
            allowClear
            onClick={e => e.stopPropagation()}
          />
        </div>
        <div style={{ 
          maxHeight: '400px', 
          overflowY: 'auto',
          padding: '8px 0'
        }}>
          {filteredAirports.length > 0 ? (
            filteredAirports.map(airport => {
              // Find the full airport data if available
              const airportEntry = airportsData.find(a => a.IATA === airport.code);
              
              return (
                <div 
                  key={airport.code} 
              style={{ 
                padding: '4px 12px',
                    cursor: 'pointer',
                    '&:hover': {
                      backgroundColor: '#f5f5f5'
                    }
              }}
            >
              <Checkbox
                    checked={destFilter.airports.includes(airport.code)}
                onChange={e => {
                  const isChecked = e.target.checked;
                      handleChange({
                        mode: destFilter.mode,
                        airports: isChecked 
                          ? [...destFilter.airports, airport.code]
                          : destFilter.airports.filter(a => a !== airport.code)
                      });
                    }}
                  >
                    <div style={{ display: 'flex', flexDirection: 'column' }}>
                      <span style={{ fontWeight: 500 }}>{airport.code}</span>
                      <span style={{ fontSize: '12px', color: '#666' }}>
                        {airportEntry 
                          ? `${airportEntry.Name} (${airportEntry.Country})` 
                          : (airport.name || '')}
                      </span>
                    </div>
                  </Checkbox>
                </div>
              );
            })
          ) : (
            <div style={{ padding: '8px 12px', color: '#999', textAlign: 'center' }}>
              No airports found
            </div>
          )}
        </div>
        {destFilter.airports.length > 0 && (
          <div style={{ padding: '8px 12px', borderTop: '1px solid #f0f0f0' }}>
            <Button 
              size="small"
              type="primary"
              onClick={() => handleChange({ mode: destFilter.mode, airports: [] })}
              block
            >
              Clear Selections ({destFilter.airports.length})
            </Button>
          </div>
        )}
      </div>
    );
  };

  // Delete a filter based on its ID and type
  const deleteFilter = (filterId, filterType) => {
    // Remove the filter from the additional filters array
    setAdditionalFilters(prev => prev.filter(f => !(f.id === filterId && f.type === filterType)));
    
    // Also remove the corresponding filter data
    if (filterType === 'group') {
      setGroupFilters(prev => {
        const newFilters = { ...prev };
        delete newFilters[filterId];
        return newFilters;
      });
    } else if (filterType === 'segment') {
      setSegmentFilters(prev => {
        const newFilters = { ...prev };
        delete newFilters[filterId];
        return newFilters;
      });
    }
    
    // Clean up search text states
    if (filterType === 'group') {
      setGroupSourceSearchTexts(prev => {
        const newTexts = { ...prev };
        delete newTexts[filterId];
        return newTexts;
      });
      setGroupAirlinesSearchTexts(prev => {
        const newTexts = { ...prev };
        delete newTexts[filterId];
        return newTexts;
      });
      setGroupDateSearchTexts(prev => {
        const newTexts = { ...prev };
        delete newTexts[filterId];
        return newTexts;
      });
    } else if (filterType === 'segment') {
      setSegmentSourceSearchTexts(prev => {
        const newTexts = { ...prev };
        delete newTexts[filterId];
        return newTexts;
      });
      setSegmentAirlinesSearchTexts(prev => {
        const newTexts = { ...prev };
        delete newTexts[filterId];
        return newTexts;
      });
      setSegmentDateSearchTexts(prev => {
        const newTexts = { ...prev };
        delete newTexts[filterId];
        return newTexts;
      });
    }
  };

  // Render a simplified segments dropdown for segment-based filters
  const renderSegmentsDropdownSimple = (filterId) => {
    const segments = getUniqueSegments();
    const currentFilter = segmentFilters[filterId] || {};
    const selectedSegments = currentFilter.segments || [];
    
    // Filter segments based on search text
    const filteredSegments = segments.filter(segment => 
      segment.toLowerCase().includes(segmentSearchText.toLowerCase())
    );

    return (
      <div style={{ 
        backgroundColor: 'white', 
        boxShadow: '0 3px 6px -4px rgba(0,0,0,.12), 0 6px 16px 0 rgba(0,0,0,.08), 0 9px 28px 8px rgba(0,0,0,.05)',
        borderRadius: '8px',
        padding: '8px 0',
        width: '320px'
      }}>
        <div style={{ padding: '8px 12px', borderBottom: '1px solid #f0f0f0' }}>
          <Input
            placeholder="Search segments..."
            value={segmentSearchText}
            onChange={e => setSegmentSearchText(e.target.value)}
            size="small"
            allowClear
            onClick={e => e.stopPropagation()}
          />
        </div>
        <div style={{ 
          maxHeight: '400px', 
          overflowY: 'auto',
          padding: '8px 0'
        }}>
          {filteredSegments.map(segment => {
            const [origin, destination] = segment.split('-');
            return (
            <div 
                key={segment} 
              style={{ 
                padding: '4px 12px',
                  cursor: 'pointer',
                  '&:hover': {
                    backgroundColor: '#f5f5f5'
                  }
              }}
            >
              <Checkbox
                  checked={selectedSegments.includes(segment)}
                onChange={e => {
                  const isChecked = e.target.checked;
                    setSegmentFilters(prev => ({
                    ...prev,
                    [filterId]: {
                      ...prev[filterId],
                        segments: isChecked 
                          ? [...(prev[filterId]?.segments || []), segment]
                          : (prev[filterId]?.segments || []).filter(s => s !== segment)
                    }
                  }));
                }}
              >
                  <div style={{ display: 'flex', flexDirection: 'column' }}>
                    <span style={{ fontWeight: '500' }}>{origin} → {destination}</span>
                    <span style={{ fontSize: '12px', color: '#666' }}>{segment}</span>
                </div>
              </Checkbox>
            </div>
            );
          })}
          {filteredSegments.length === 0 && (
            <div style={{ padding: '8px 12px', color: '#999', textAlign: 'center' }}>
              No segments found
            </div>
          )}
        </div>
        {selectedSegments.length > 0 && (
          <div style={{ padding: '8px 12px', borderTop: '1px solid #f0f0f0' }}>
            <Button 
              size="small"
              type="primary"
              onClick={() => setSegmentFilters(prev => ({
                ...prev,
                [filterId]: {
                  ...prev[filterId],
                  segments: []
                }
              }))}
              block
            >
              Clear Selections ({selectedSegments.length})
            </Button>
          </div>
        )}
      </div>
    );
  };

  // Add filter menu content
  const addFilterMenu = () => {
    return (
      <Menu>
        <Menu.Item 
          key="group" 
          onClick={() => {
            const filterId = `group-${Date.now()}`;
            setAdditionalFilters(prev => [...prev, { id: filterId, type: 'group' }]);
            setGroupFilters(prev => ({
              ...prev,
              [filterId]: {
                originFilter: { mode: 'include', airports: [] },
                destFilter: { mode: 'include', airports: [] },
                sourceFilter: { mode: 'include', sources: [] },
                airlinesFilter: { mode: 'include', airlines: [] },
                dateFilter: [],
                directOnly: false
              }
            }));
          }}
        >
          Add Group-based Filter
        </Menu.Item>
        <Menu.Item 
          key="segment" 
          onClick={() => {
            const filterId = `segment-${Date.now()}`;
            setAdditionalFilters(prev => [...prev, { id: filterId, type: 'segment' }]);
            setSegmentFilters(prev => ({
              ...prev,
              [filterId]: {
                segments: [],
                sourceFilter: { mode: 'include', sources: [] },
                airlinesFilter: { mode: 'include', airlines: [] },
                dateFilter: [],
                directOnly: false
              }
            }));
          }}
        >
          Add Segment-based Filter
        </Menu.Item>
      </Menu>
    );
  };

  // Sort segments based on user-defined order or alphabetically
  const sortSegments = (a, b) => {
    // Extract routes when this is used as a comparator function
    const routeA = a.route || a;
    const routeB = b.route || b;
    
    // Handle segment ordering if defined
    if (segmentOrder.length > 0) {
      const indexA = segmentOrder.indexOf(routeA);
      const indexB = segmentOrder.indexOf(routeB);
      
      // If both are in the ordered list
      if (indexA !== -1 && indexB !== -1) {
        return indexA - indexB;
      }
      
      // If only one is in the ordered list, prioritize it
      if (indexA !== -1) return -1;
      if (indexB !== -1) return 1;
    }
    
    // Default alphabetical sort
    return routeA.localeCompare(routeB);
  };

  // Render group airlines dropdown
  const renderGroupAirlinesDropdown = (filterId) => {
    const airlines = getUniqueAirlines();
    const currentFilter = groupFilters[filterId] || {};
    const airlinesFilter = currentFilter.airlinesFilter || { mode: 'include', airlines: [] };
    const searchText = groupAirlinesSearchTexts[filterId] || '';
    
    // Filter airlines based on search text
    const filteredAirlines = airlines.filter(airline => 
      airline.name.toLowerCase().includes(searchText.toLowerCase()) ||
      airline.code.toLowerCase().includes(searchText.toLowerCase())
    );

    return (
      <div style={{ 
        backgroundColor: 'white', 
        boxShadow: '0 3px 6px -4px rgba(0,0,0,.12), 0 6px 16px 0 rgba(0,0,0,.08), 0 9px 28px 8px rgba(0,0,0,.05)',
        borderRadius: '8px',
        padding: '8px 0',
        width: '320px'
      }}>
        <div style={{ padding: '8px 12px', borderBottom: '1px solid #f0f0f0' }}>
          <Radio.Group
            value={airlinesFilter.mode} 
            onChange={e => setGroupFilters(prev => ({
              ...prev,
              [filterId]: {
                ...prev[filterId],
                airlinesFilter: {
                  ...prev[filterId]?.airlinesFilter || {},
                  mode: e.target.value
                }
              }
            }))}
            size="small"
          >
            <Radio.Button value="include">Include</Radio.Button>
            <Radio.Button value="exclude">Exclude</Radio.Button>
          </Radio.Group>
        </div>
        <div style={{ padding: '8px 12px', borderBottom: '1px solid #f0f0f0' }}>
          <Input
            placeholder="Search airlines..."
            value={searchText}
            onChange={e => setGroupAirlinesSearchTexts(prev => ({
              ...prev,
              [filterId]: e.target.value
            }))}
            size="small"
            allowClear
            onClick={e => e.stopPropagation()}
          />
        </div>
        <div style={{ 
          maxHeight: '400px', 
          overflowY: 'auto',
          padding: '8px 0'
        }}>
          {filteredAirlines.map(airline => (
            <div 
              key={airline.code} 
              style={{ 
                padding: '4px 12px',
                cursor: 'pointer',
                '&:hover': {
                  backgroundColor: '#f5f5f5'
                }
              }}
            >
              <Checkbox
                checked={airlinesFilter.airlines.includes(airline.code)}
                onChange={e => {
                  const isChecked = e.target.checked;
                  setGroupFilters(prev => ({
                    ...prev,
                    [filterId]: {
                      ...prev[filterId],
                      airlinesFilter: {
                        ...prev[filterId]?.airlinesFilter || { mode: 'include' },
                        airlines: isChecked 
                          ? [...(prev[filterId]?.airlinesFilter?.airlines || []), airline.code]
                          : (prev[filterId]?.airlinesFilter?.airlines || []).filter(a => a !== airline.code)
                      }
                    }
                  }));
                }}
              >
                <div style={{ 
                  display: 'flex',
                  alignItems: 'center', 
                  gap: '8px'
                }}>
                  {/* Logo */}
                  <div style={{ 
                    width: '24px', 
                    height: '24px',
                    flexShrink: 0
                  }}>
                    <img 
                      src={`/${airline.code}.png`} 
                      alt={airline.name} 
                      style={{ 
                        width: '100%', 
                        height: '100%', 
                        objectFit: 'contain',
                        borderRadius: '4px'
                      }}
                      onError={(e) => { e.target.style.display = 'none'; }}
                    />
                  </div>
                  
                  {/* Text content */}
                  <div style={{ display: 'flex', flexDirection: 'column' }}>
                    <span style={{ fontWeight: '500' }}>{airline.name}</span>
                    <span style={{ fontSize: '12px', color: '#666' }}>{airline.code}</span>
                  </div>
                </div>
              </Checkbox>
            </div>
          ))}
          {filteredAirlines.length === 0 && (
            <div style={{ padding: '8px 12px', color: '#999', textAlign: 'center' }}>
              No airlines found
            </div>
          )}
        </div>
        {airlinesFilter.airlines.length > 0 && (
          <div style={{ padding: '8px 12px', borderTop: '1px solid #f0f0f0' }}>
            <Button 
              size="small"
              type="primary"
              onClick={() => setGroupFilters(prev => ({
                ...prev,
                [filterId]: {
                  ...prev[filterId],
                  airlinesFilter: {
                    ...prev[filterId]?.airlinesFilter || {},
                    airlines: []
                  }
                }
              }))}
              block
            >
              Clear Selections ({airlinesFilter.airlines.length})
            </Button>
          </div>
        )}
      </div>
    );
  };

  // Render segment airlines dropdown
  const renderSegmentAirlinesDropdown = (filterId) => {
    const airlines = getUniqueAirlines();
    const currentFilter = segmentFilters[filterId] || {};
    const airlinesFilter = currentFilter.airlinesFilter || { mode: 'include', airlines: [] };
    const searchText = segmentAirlinesSearchTexts[filterId] || '';
    
    // Filter airlines based on search text
    const filteredAirlines = airlines.filter(airline => 
      airline.name.toLowerCase().includes(searchText.toLowerCase()) ||
      airline.code.toLowerCase().includes(searchText.toLowerCase())
    );

    return (
      <div style={{ 
        backgroundColor: 'white', 
        boxShadow: '0 3px 6px -4px rgba(0,0,0,.12), 0 6px 16px 0 rgba(0,0,0,.08), 0 9px 28px 8px rgba(0,0,0,.05)',
        borderRadius: '8px',
        padding: '8px 0',
        width: '320px'
      }}>
        <div style={{ padding: '8px 12px', borderBottom: '1px solid #f0f0f0' }}>
          <Radio.Group 
            value={airlinesFilter.mode} 
            onChange={e => setSegmentFilters(prev => ({
              ...prev,
              [filterId]: {
                ...prev[filterId],
                airlinesFilter: {
                  ...prev[filterId]?.airlinesFilter || {},
                  mode: e.target.value
                }
              }
            }))}
            size="small"
          >
            <Radio.Button value="include">Include</Radio.Button>
            <Radio.Button value="exclude">Exclude</Radio.Button>
          </Radio.Group>
        </div>
        <div style={{ padding: '8px 12px', borderBottom: '1px solid #f0f0f0' }}>
          <Input
            placeholder="Search airlines..."
            value={searchText}
            onChange={e => setSegmentAirlinesSearchTexts(prev => ({
              ...prev,
              [filterId]: e.target.value
            }))}
            size="small"
            allowClear
            onClick={e => e.stopPropagation()}
          />
        </div>
        <div style={{ 
          maxHeight: '400px', 
          overflowY: 'auto',
          padding: '8px 0'
        }}>
          {filteredAirlines.map(airline => (
            <div 
              key={airline.code} 
              style={{ 
                padding: '4px 12px',
                cursor: 'pointer',
                '&:hover': {
                  backgroundColor: '#f5f5f5'
                }
              }}
            >
              <Checkbox
                checked={airlinesFilter.airlines.includes(airline.code)}
                onChange={e => {
                  const isChecked = e.target.checked;
                  setSegmentFilters(prev => ({
                    ...prev,
                    [filterId]: {
                      ...prev[filterId],
                      airlinesFilter: {
                        ...prev[filterId]?.airlinesFilter || { mode: 'include' },
                        airlines: isChecked 
                          ? [...(prev[filterId]?.airlinesFilter?.airlines || []), airline.code]
                          : (prev[filterId]?.airlinesFilter?.airlines || []).filter(a => a !== airline.code)
                      }
                    }
                  }));
                }}
              >
                <div style={{ 
                  display: 'flex',
                  alignItems: 'center', 
                  gap: '8px'
                }}>
                  {/* Logo */}
                  <div style={{ 
                    width: '24px', 
                    height: '24px',
                    flexShrink: 0
                  }}>
                    <img 
                      src={`/${airline.code}.png`} 
                      alt={airline.name} 
                      style={{ 
                        width: '100%', 
                        height: '100%', 
                        objectFit: 'contain',
                        borderRadius: '4px'
                      }}
                      onError={(e) => { e.target.style.display = 'none'; }}
                    />
                  </div>
                  
                  {/* Text content */}
                  <div style={{ display: 'flex', flexDirection: 'column' }}>
                    <span style={{ fontWeight: '500' }}>{airline.name}</span>
                    <span style={{ fontSize: '12px', color: '#666' }}>{airline.code}</span>
                  </div>
                </div>
              </Checkbox>
            </div>
          ))}
          {filteredAirlines.length === 0 && (
            <div style={{ padding: '8px 12px', color: '#999', textAlign: 'center' }}>
              No airlines found
            </div>
          )}
        </div>
        {airlinesFilter.airlines.length > 0 && (
          <div style={{ padding: '8px 12px', borderTop: '1px solid #f0f0f0' }}>
            <Button 
              size="small"
              type="primary"
              onClick={() => setSegmentFilters(prev => ({
                ...prev,
                [filterId]: {
                  ...prev[filterId],
                  airlinesFilter: {
                    ...prev[filterId]?.airlinesFilter || {},
                    airlines: []
                  }
                }
              }))}
              block
            >
              Clear Selections ({airlinesFilter.airlines.length})
            </Button>
          </div>
        )}
      </div>
    );
  };

  // Helper function to check if a route is in scope for any group or segment filter
  const isRouteInFilterScope = (route) => {
    // Check if there are any active group or segment filters
    const hasGroupFilters = Object.keys(groupFilters).length > 0;
    const hasSegmentFilters = Object.keys(segmentFilters).length > 0;
    
    // If no group or segment filters, route is not in any specific scope
    if (!hasGroupFilters && !hasSegmentFilters) {
      return false;
    }
    
    // Extract origin and destination from route
    const [origin, destination] = route.split('-');
    
    // Check if the route is in scope for any group filter
    if (hasGroupFilters) {
      for (const filterId of Object.keys(groupFilters)) {
        const filter = groupFilters[filterId];
        
        // Check if this group filter applies to this route
        const originFilter = filter.originFilter || { mode: 'include', airports: [] };
        const destFilter = filter.destFilter || { mode: 'include', airports: [] };
        
        // Skip if no origins or destinations selected
        if (originFilter.airports.length === 0 || destFilter.airports.length === 0) {
          continue;
        }
        
        // Check if origin and destination match the group filter's scope
        const matchesOrigin = originFilter.airports.includes(origin);
        const matchesDest = destFilter.airports.includes(destination);
        
        // Check if route is in scope for this group filter
        const originInScope = 
          (originFilter.mode === 'include' && matchesOrigin) || 
          (originFilter.mode === 'exclude' && !matchesOrigin);
        
        const destInScope = 
          (destFilter.mode === 'include' && matchesDest) || 
          (destFilter.mode === 'exclude' && !matchesDest);
        
        // If route is in scope for this group filter, return true
        if (originInScope && destInScope) {
          return true;
        }
      }
    }
    
    // Check if the route is in scope for any segment filter
    if (hasSegmentFilters) {
      for (const filterId of Object.keys(segmentFilters)) {
        const filter = segmentFilters[filterId];
        
        // Check if this segment filter applies to this route
        const appliesTo = filter.segments || [];
        
        // Skip if no segments selected
        if (appliesTo.length === 0) {
          continue;
        }
        
        // Check if route is in the segment filter's scope
        if (appliesTo.includes(route)) {
          return true;
        }
      }
    }
    
    // If we get here, the route is not in scope for any filter
    return false;
  };

  return (
    <div>
      {/* Calendar container */}
      <div className="calendar-container" style={{ padding: '20px' }}>
        {/* Add filter buttons on top */}
        <div style={{ 
          display: 'flex',
          justifyContent: 'space-between', // Changed to space-between to put Add filter on right
          marginBottom: '8px', // Reduced margin to accommodate additional filter line
          gap: '8px',
          alignItems: 'center'
        }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
            <span style={{ 
              fontWeight: 600, 
              marginRight: '8px',
              fontSize: '14px'
            }}>
              Global Filter:
            </span>
            
            <Dropdown 
              dropdownRender={renderSegmentsDropdown}
              trigger={['click']}
            >
              <Button 
                type={segmentFilter.segments.length > 0 ? "primary" : "default"}
                size="small"
                icon={<DownOutlined />}
                style={{ 
                  fontWeight: segmentFilter.segments.length > 0 ? 600 : 400
                }}
              >
                Segments {segmentFilter.segments.length > 0 && `(${segmentFilter.segments.length})`}
              </Button>
            </Dropdown>
            
            <Dropdown 
              dropdownRender={renderClassDropdown}
              trigger={['click']}
            >
              <Button 
                type={classFilter.length > 0 ? "primary" : "default"}
                size="small"
                icon={<DownOutlined />}
                style={{ 
                  fontWeight: classFilter.length > 0 ? 600 : 400
                }}
              >
                Class {classFilter.length > 0 && `(${classFilter.length})`}
              </Button>
            </Dropdown>
            
            <Dropdown 
              dropdownRender={renderSourcesDropdown}
              trigger={['click']}
            >
              <Button 
                type={sourceFilter.sources.length > 0 ? "primary" : "default"}
                size="small"
                icon={<DownOutlined />}
                style={{ 
                  fontWeight: sourceFilter.sources.length > 0 ? 600 : 400
                }}
              >
                Sources {sourceFilter.sources.length > 0 && `(${sourceFilter.sources.length})`}
              </Button>
            </Dropdown>
            
            <Dropdown 
              dropdownRender={renderAirlinesDropdown}
              trigger={['click']}
            >
              <Button 
                type={airlinesFilter.airlines.length > 0 ? "primary" : "default"}
                size="small"
                icon={<DownOutlined />}
                style={{ 
                  fontWeight: airlinesFilter.airlines.length > 0 ? 600 : 400
                }}
              >
                Airlines {airlinesFilter.airlines.length > 0 && `(${airlinesFilter.airlines.length})`}
              </Button>
            </Dropdown>
            
            <Dropdown 
              dropdownRender={renderPointsDropdown}
              trigger={['click']}
            >
              <Button 
                type={pointsFilter ? "primary" : "default"}
                size="small"
                icon={<DownOutlined />}
                style={{ 
                  fontWeight: pointsFilter ? 600 : 400
                }}
              >
                Points {pointsFilter && `(${pointsFilter[0].toLocaleString()}-${pointsFilter[1].toLocaleString()})`}
              </Button>
            </Dropdown>
            
            <Dropdown 
              dropdownRender={renderDatesDropdown}
              trigger={['click']}
            >
              <Button 
                type={dateFilter.length > 0 ? "primary" : "default"}
                size="small"
                icon={<DownOutlined />}
                style={{ 
                  fontWeight: dateFilter.length > 0 ? 600 : 400
                }}
              >
                Dates {dateFilter.length > 0 && `(${dateFilter.length})`}
              </Button>
            </Dropdown>
            
            <Checkbox 
              checked={directFilter}
              onChange={e => setDirectFilter(e.target.checked)}
              style={{ marginLeft: '8px' }}
            >
              <span style={{ fontWeight: directFilter ? 600 : 400 }}>Direct Only</span>
            </Checkbox>
          </div>
          
          {/* Add filter button on right side */}
          <Dropdown 
            overlay={addFilterMenu}
            placement="bottomRight"
            trigger={['click']}
          >
            <Button 
              type="default"
              size="small"
              icon={<PlusOutlined />}
              style={{ fontWeight: 500 }}
            >
              Add filter
            </Button>
          </Dropdown>
        </div>
        
        {/* Render additional filter line if a type is selected */}
        {additionalFilters.length > 0 && (
          <div style={{ 
            display: 'flex',
            flexDirection: 'column',
            justifyContent: 'flex-start',
            marginBottom: '16px',
            gap: '8px',
            alignItems: 'flex-start'
          }}>
            {renderAdditionalFilter()}
          </div>
        )}

        {/* Calendar header */}
        <div style={{ 
          display: 'flex', 
          justifyContent: 'space-between', 
          alignItems: 'center', 
          marginBottom: '20px' 
        }}>
          <Button 
            type="primary"
            onClick={goToPrevMonth}
            style={{ backgroundColor: '#000000' }}
          >
            &larr;
          </Button>
          <Title level={4} style={{ margin: 0 }}>{monthNames[currentMonth]} {currentYear}</Title>
          <Button 
            type="primary"
            onClick={goToNextMonth}
            style={{ backgroundColor: '#000000' }}
          >
            &rarr;
          </Button>
        </div>

        {/* Calendar grid */}
        <div style={{ 
          display: 'grid', 
          gridTemplateColumns: 'repeat(7, 200px)',
          border: '1px solid #f0f0f0',
          backgroundColor: '#f0f0f0',
          gap: '1px',
          fontFamily: 'Menlo, monospace',
          width: 'fit-content'
        }}>
          {/* Day headers */}
          {dayNames.map(day => (
            <div key={day} style={{ 
              backgroundColor: '#f5f5f5',
              padding: '8px',
              textAlign: 'center',
              fontWeight: '500',
              width: '200px'
            }}>
              {day}
            </div>
          ))}

          {/* Empty cells for days of week before the first day of month */}
          {Array.from({ length: firstDayOfMonth }).map((_, index) => (
            <div key={`empty-${index}`} style={{ 
              backgroundColor: 'white',
              minHeight: '120px',
              padding: '8px',
              width: '200px'
            }} />
          ))}

          {/* Calendar day cells */}
          {Array.from({ length: daysInMonth }).map((_, index) => {
            const day = index + 1;
            const dateString = formatDate(currentYear, currentMonth, day);
            
            // Skip rendering this cell if it's filtered out by date filter
            if (dateFilter.length > 0 && !dateFilter.includes(dateString)) {
              return (
                <div
                  key={`day-${day}`}
                  style={{
                    backgroundColor: '#f9f9f9',
                    minHeight: '120px',
                    padding: '8px',
                    opacity: 0.5,
                    width: '200px'
                  }}
                >
                  <div style={{ fontWeight: 'bold', marginBottom: '8px' }}>{day}</div>
                  <div style={{ 
                    fontSize: '12px', 
                    color: '#999',
                    textAlign: 'center',
                    marginTop: '20px'
                  }}>
                    Filtered out
                  </div>
                </div>
              );
            }
            
            const rawFlights = flightData?.data?.[dateString] || {};
            // Apply segment and class filtering
            const flights = filterFlights(rawFlights);
            
            // Sort routes based on the pattern: BOS-EWR/JFK/LGA first, then EWR/JFK/LGA-MIA
            const validFlights = Object.entries(flights)
              .map(([route, data]) => ({
                route,
                classes: {
                  Y: data.classes.Y.available,
                  W: data.classes.W.available,
                  J: data.classes.J.available,
                  F: data.classes.F.available,
                  YDirect: data.classes.Y.direct,
                  WDirect: data.classes.W.direct,
                  JDirect: data.classes.J.direct,
                  FDirect: data.classes.F.direct,
                  YSources: data.classes.Y.sources,
                  WSources: data.classes.W.sources,
                  JSources: data.classes.J.sources,
                  FSources: data.classes.F.sources,
                  YFlights: data.classes.Y.flights,
                  WFlights: data.classes.W.flights,
                  JFlights: data.classes.J.flights,
                  FFlights: data.classes.F.flights
                },
                // Track if this route is in scope for any filters
                inScope: isRouteInFilterScope(route)
              }))
              .sort(sortSegments);

            // Filter to only show routes with at least one available class
            // But preserve routes that are not in scope for any filter
            const filteredValidFlights = validFlights.filter(segment => {
              // If the route is not in scope for any filter, always include it
              if (!segment.inScope) return true;
              
              // If it's in scope, check if it passes the filters
              // Check if there's at least one available cabin class after all filtering
              const classesToCheck = ['Y', 'W', 'J', 'F'];
              return classesToCheck.some(classCode => {
                if (!segment.classes[classCode]) return false;
                // Get the flights for this class after all filtering
                const flights = getFlightsForClassWithFilters(segment.route, classCode, dateString, segment.classes);
                return flights.length > 0;
              });
            });

            const showFlights = filteredValidFlights.length > 0;
            const isSelected = isDateInRange(dateString);
            const isStart = dateString === selectionRef.current.start;
            const isEnd = dateString === selectionRef.current.end;
            
            // Pagination logic
            const ITEMS_PER_PAGE = 10;
            const currentPage = cellPages[dateString] || 0;
            const totalPages = Math.ceil(filteredValidFlights.length / ITEMS_PER_PAGE);
            const paginatedFlights = filteredValidFlights.slice(
              currentPage * ITEMS_PER_PAGE, 
              (currentPage + 1) * ITEMS_PER_PAGE
            );
            const showPagination = filteredValidFlights.length > ITEMS_PER_PAGE;

            return (
              <div
                key={`day-${day}`}
                style={{
                  backgroundColor: isSelected ? '#e6f4ff' : 'white',
                  minHeight: '120px',
                  padding: '8px',
                  fontFamily: 'Menlo, monospace',
                  cursor: 'pointer',
                  border: isStart || isEnd ? '2px solid #000000' : 'none',
                  width: '200px',
                  position: 'relative' // Added for pagination positioning
                }}
                onClick={(e) => {
                  e.stopPropagation();
                  handleDateClick(dateString);
                }}
              >
                <div style={{ 
                  fontWeight: 'bold', 
                  marginBottom: '8px',
                  fontSize: '13px',
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center'
                }}>
                  <span>{day}</span>
                  {filteredValidFlights.length > 0 && (
                    <span style={{ 
                      fontSize: '11px', 
                      color: '#666',
                      backgroundColor: '#f5f5f5',
                      padding: '1px 5px',
                      borderRadius: '10px'
                    }}>
                      {filteredValidFlights.length} route{filteredValidFlights.length !== 1 ? 's' : ''}
                    </span>
                  )}
                </div>
                {showFlights ? (
                  <>
                  <div style={{ fontSize: '12px' }}>
                      {paginatedFlights.map((segment, idx) => (
                      <div 
                        key={idx} 
                        style={{ 
                          marginBottom: '4px',
                          display: 'flex',
                          justifyContent: 'space-between',
                          alignItems: 'center',
                          gap: '20px'
                        }}
                      >
                        <div style={{ 
                          fontSize: '14px',
                          fontFamily: 'Menlo, monospace'
                        }}>
                          {segment.route}
                        </div>
                        {renderAvailabilityBadges(segment.route, segment.classes, dateString)}
                      </div>
                    ))}
                  </div>
                    
                    {/* Pagination controls */}
                    {showPagination && (
                      <div 
                        style={{
                          display: 'flex',
                          justifyContent: 'space-between',
                          alignItems: 'center',
                          marginTop: '8px',
                          fontSize: '11px',
                          color: '#555',
                          borderTop: '1px solid #f0f0f0',
                          paddingTop: '6px'
                        }}
                        onClick={(e) => e.stopPropagation()} // Prevent date selection when clicking pagination
                      >
                        <button
                          disabled={currentPage === 0}
                          onClick={(e) => {
                            e.stopPropagation();
                            handlePageChange(dateString, 'prev', e);
                          }}
                          style={{
                            padding: '2px 6px',
                            backgroundColor: 'transparent',
                            border: '1px solid #d9d9d9',
                            borderRadius: '4px',
                            cursor: currentPage === 0 ? 'not-allowed' : 'pointer',
                            color: currentPage === 0 ? '#bbb' : '#555',
                            transition: 'all 0.2s',
                            fontSize: '10px'
                          }}
                        >
                          &lt;
                        </button>
                        
                        <span style={{ fontSize: '10px' }}>{`${currentPage + 1} / ${totalPages}`}</span>
                        
                        <button
                          disabled={currentPage === totalPages - 1}
                          onClick={(e) => {
                            e.stopPropagation();
                            handlePageChange(dateString, 'next', e);
                          }}
                          style={{
                            padding: '2px 6px',
                            backgroundColor: 'transparent',
                            border: '1px solid #d9d9d9',
                            borderRadius: '4px',
                            cursor: currentPage === totalPages - 1 ? 'not-allowed' : 'pointer',
                            color: currentPage === totalPages - 1 ? '#bbb' : '#555',
                            transition: 'all 0.2s',
                            fontSize: '10px'
                          }}
                        >
                          &gt;
                        </button>
                      </div>
                    )}
                  </>
                ) : (
                  <div style={{ 
                    textAlign: 'center', 
                    color: '#999', 
                    fontSize: '12px',
                    marginTop: '32px',
                    fontFamily: 'Menlo, monospace'
                  }}>
                    No flights
                  </div>
                )}
              </div>
            );
          })}
        </div>

        {/* Error message */}
        {error && (
          <div style={{ 
            color: '#ff4d4f', 
            marginTop: '16px',
            textAlign: 'center' 
          }}>
            {error}
          </div>
        )}
      </div>
    </div>
  );
};

export default NormalFlightAvailabilityCalendar; 